NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
# Production must match the deployed frontend origin, for example:
# APP_ORIGIN=https://immoklu-front-web.vercel.app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/immoklu
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback
STORAGE_PROVIDER=R2
STORAGE_BUCKET=immoklu-dev
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
